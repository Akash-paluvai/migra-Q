# Migra-Q Server Configuration
PROJECT_NAME="Migra-Q"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database & Sandbox Storage
DATABASE_URL="sqlite:///./migraq.db"
DUCKDB_MEMORY_LIMIT="2GB"
DUCKDB_THREADS=4

# LLM API Keys (Optional, fallback for complex SQL translations & repairs)
OPENAI_API_KEY="your-openai-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# Security & CORS
SECRET_KEY="migraq-secret-key-change-in-production"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Quality Gate Defaults
MIN_ASSURANCE_SCORE_PASS=85.0
MAX_ROW_DIFF_TOLERANCE=0.0001
