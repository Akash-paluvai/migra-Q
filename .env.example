# Application Environment
APP_ENV=development
APP_NAME=migra-q
APP_HOST=0.0.0.0
APP_PORT=8000

# Persistence & Database
DATABASE_URL=postgresql+psycopg://migraq:migraq@localhost:5432/migraq
PERSISTENCE_MODE=postgres  # "postgres" for dev/demo/prod, "memory" for test suite

# Generative AI / LLM Engine Configuration
# Set LLM_PROVIDER=openai and provide LLM_API_KEY for live LLM translation
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_API_KEY=your_openai_api_key_here
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=6000
LOG_TRANSLATION_SQL=False

# Logging & Security
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
